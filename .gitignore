# plan, datacenter, template) et reste versionné.
*.tfvars
*.tfvars.json
!*.auto.tfvars
!*.tfvars.example

# Divers
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.envrc
*.tfplan
